{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.fan_wyvern.baby" : {
			"initial_state" : "baby",
			"states" : {
				"baby" : {
					"animations" : [
						{
							"baby_transform" : "query.is_baby"
						}
					]
				}
			}
		},
		"controller.animation.fan_wyvern.dive_down" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"blend_transition" : 2.0,
					"blend_via_shortest_path" : true,
					"transitions" : [
						{
							"dive_down" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && (query.vertical_speed < -14 && query.ground_speed > 10)"
						}
					]
				},
				"dive_down" : {
					"animations" : [ "dive_down" ],
					"blend_transition" : 3.2,
					"blend_via_shortest_path" : true,
					"transitions" : [
						{
							"default" : "query.is_on_ground || q.is_sitting || query.is_in_water || (query.vertical_speed > -14 && query.ground_speed <= 10)"
						}
					]
				}
			}
		},
		"controller.animation.fan_wyvern.look_at_target" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"animations" : [ "look_at_target" ]
				}
			}
		},
		"controller.animation.fan_wyvern.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"attack" : "query.has_target"
						}
					]
				},
				"attack" : {
					"animations" : [ "attack" ],
					"transitions" : [
						{
							"default" : "!query.has_target"
						}
					]
				}
			}
		},
		 "controller.animation.fan_wyvern.breathe" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"blend_transition" : 0.4,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"breathe" : "!query.has_rider && query.is_on_ground && !query.is_in_water"
						}
					]
				},
				"breathe" : {
					"animations" : [ "breathe" ],
					"transitions" : [
						{
							"default" : "query.has_rider || !query.is_on_ground"
						}
					]
				}
			}
		},
		"controller.animation.fan_wyvern.blink" : {
			"initial_state" : "blink",
			"states" : {
				"shutem" : {
					"animations" : [ "shut" ],
					"blend_transition" : 0.4,
					"blend_via_shortest_path" : true,
					"transitions" : [
						{
							"blink" : "( q.time_of_day > 0.18 && q.time_of_day < 0.82 ) || !q.is_sitting"
						},
						{
							"lazy_blink" : "math.random(1,500) > 499"
						}            
					]
				},
				"blink" : {
					"animations" : [ "blink" ],
					"blend_transition" : 0.4,          
					"transitions" : [
						{
							"shutem" : "( q.time_of_day < 0.18 || q.time_of_day > 0.82 ) && q.is_sitting"
						}
					]
				},
				"lazy_blink" : {
					"animations" : [ "blink" ],
					"blend_transition" : 1.0,          
					"transitions" : [
						{
							"shutem" : "math.random(1,200) > 199"
						},
						{
							"blink" : "( q.time_of_day > 0.18 && q.time_of_day < 0.82 ) || !q.is_sitting"
						}
					]
				}
			}
		},
		"controller.animation.fan_wyvern.move" : {
			"initial_state" : "walking",
			"states" : {
				"walking" : {
					"animations" : [
						{
							"walk" : "query.is_on_ground && query.ground_speed"
						}
            ],
          "blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"swimming" : "query.is_in_water && !q.is_sitting"
						},
						{
							"flyingup" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && query.vertical_speed >= 0"
						},
						{
							"flyingdown" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && query.vertical_speed < 0"
						},
						{
							"sitting" : "q.is_sitting"
						}
					]
				},
				"swimming" : {
					"animations" : [ "swim" , "dive" ],
          "blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"walking" : "query.is_on_ground && !query.is_in_water"
						},
						{
							"flyingup" : "!query.is_on_ground && !query.is_in_water && query.vertical_speed >= 0"
						},
						{
							"flyingdown" : "!query.is_on_ground && !query.is_in_water && query.vertical_speed < 0"
						},
						{
							"sitting" : "q.is_sitting"
						}
					]
				},
				"flyingup" : {
					"animations" : [ "fly" , "dive" ],
          "blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"swimming" : "query.is_in_water && !q.is_sitting"
						},
						{
							"walking" : "query.is_on_ground && !q.is_sitting"
						},
						{
							"flyingdown" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && query.vertical_speed < 0"
						},
						{
							"sitting" : "q.is_sitting"
						}
					]
				},
				"flyingdown" : {
					"animations" : [ "glyde" , "dive" ],
          "blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"swimming" : "query.is_in_water && !q.is_sitting"
						},
						{
							"walking" : "query.is_on_ground"
						},
						{
							"flyingup" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && query.vertical_speed >= 0"
						},
						{
							"sitting" : "q.is_sitting"
						}
					]
				},
				"sleeping" : {
					"animations" : [ "sleep" ],
          "blend_transition" : 1.2,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"walking" : "!q.is_sitting"
						},
						{
							"sitting" : "q.time_of_day > 0.22 && q.time_of_day < 0.77 && query.is_sitting"
						}
					]
				},
				"sitting" : {
					"animations" : [ "sit" ],
          "blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
					"transitions" : [
						{
							"sleeping" : "q.time_of_day < 0.22 || q.time_of_day > 0.77 && q.is_sitting && math.random(1,1001) > 1000"
						},
						{
							"swimming" : "query.is_in_water && !q.is_sitting"
						},
						{
							"walking" : "query.is_on_ground && !q.is_sitting"
						},
						{
							"flyingup" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && query.vertical_speed >= 0"
						},
						{
							"flyingdown" : "!query.is_on_ground && !q.is_sitting && !query.is_in_water && query.vertical_speed < 0"
						}
					]
				}
			}
		}
	}
}
