{
	"format_version" : "1.10.0",
	"animation_controllers" : {
    "controller.animation.snow_walker.look_at_target" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"animations" : [ "look_at_target" ]
				}
			}
		},
    "controller.animation.snow_walker.move" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"animations" : [
            {
							"walk" : "query.modified_move_speed"
						}
					],
          "transitions" : [
						{
							"attack" : "variable.snow_walker.attack"
						}
					]
				},
				"attack" : {
					"animations" : [ "attack" ],
					"blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
          "transitions" : [
						{
							"default" : "!variable.snow_walker.attack"
						}
					]
				}
			}
		}
	}
}
