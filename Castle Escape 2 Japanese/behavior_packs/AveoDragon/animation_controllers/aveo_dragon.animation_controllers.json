{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.aveo_dragon": {
			"initial_state" : "walking",
			"states": {
				"flying": {
					"transitions": [
						{
							"flying2": "query.has_rider && !query.is_on_ground"
						},
            {
              "walking": "query.is_on_ground"
            }
					],
					"on_entry": [
						"/execute @p[rx=-80,rxm=-90] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 1 25 true",
						"/execute @p[rx=-65,rxm=-80] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 1 12 true",
            "/execute @p[rx=-35,rxm=-65] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 1 7 true",
            "/execute @p[rx=-25,rxm=-35] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 1 3 true",
            "/execute @p[rx=-15,rxm=-25] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 1 1 true",
            "/execute @p[rx=-5,rxm=-15] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 1 0 true",
            "/execute @p[rx=5,rxm=-5] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s slow_falling 2 23 true",
            "/execute @p[rx=85,rxm=5] ~ ~ ~ execute @e[r=3,type=goodlord:aveo_dragon] ~ ~ ~ effect @s slow_falling 1 0 true"
					]
				},
				"flying2": {
					"transitions": [
						{
							"flying": "math.random(1,10) > 8"
						},
            {
              "flying_wind": "math.random(1,20) > 19"
            }
					]
				},
				"flying_wind": {
					"transitions": [
						{
							"flying": "math.random(1,10) > 8"
						}
					],
					"on_entry": [
						"/playsound goodlord.dragon_wind @a[r=7]"
					]
				},
        "walking": {
          "transitions": [
						{
							"flying": "!query.is_on_ground"
						},
						{
							"walking2": "query.is_on_ground && !query.is_sitting && math.random(1,10) > 5"
						},
						{
							"sitting": "query.is_sitting"
						},
            {
              "quick_flap": "math.random(1,29) > 28"
            }
          ],
					"on_entry": [
						"/execute @e[r=2,type=goodlord:aveo_dragon] ~ ~ ~ effect @s slowness 2 3 true"
					]
        },
        "walking2": {
          "transitions": [
						{
							"walking": "math.random(1,10) > 8"
						}
          ]
        },
        "sitting": {
          "transitions": [
						{
							"flying": "!query.is_on_ground"
						},
						{
							"walking": "query.is_on_ground && !query.is_sitting"
						},
						{
							"sitting2": "query.is_sitting"
						}
          ],
          "blend_transition" : 0.5
        },
        "sitting2": {
          "transitions": [
						{
							"sitting": "math.random(1,10) > 8"
						}
          ]
        },
        "quick_flap": {
					"on_entry": [
						"/execute @e[r=2,type=goodlord:aveo_dragon] ~ ~ ~ effect @s levitation 2 0 true",
            "/playsound goodlord.dragon_fast_flap @a[r=7]"
					],
          "transitions": [
						{
							"walking2": "query.is_on_ground"
						}
          ]
        }
			}
		}
	}
}