{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.snow_walker": {
			"initial_state" : "start",
			"states": {
				"start": {
					"transitions": [
						{
							"attack1": "query.is_delayed_attacking"
						},
						{
							"really_freeze": "math.random(1,5) > 4"
						}
					]
				},
				"attack1": {
					"transitions": [
						{
							"attack2": "query.is_delayed_attacking"
						},
						{
							"really_freeze": "math.random(1,5) > 4"
						}
					],
					"on_entry": [
						"/execute @e[r=2,family=!golem] ~ ~ ~ effect @s levitation 1 1 true",
						"/execute @e[r=5,family=!golem] ~ ~ ~ effect @s slowness 1 3 true"
					]
				},
				"attack2": {
					"transitions": [
						{
							"attack1": "query.is_delayed_attacking"
						},
						{
							"really_freeze": "math.random(1,5) > 4"
						}
					],
					"on_entry": [
						"/execute @e[r=3,family=!golem] ~ ~ ~ effect @s levitation 1 1 true",
						"/execute @e[r=5,family=!golem] ~ ~ ~ effect @s slowness 1 3 true"
					]
				},
        "really_freeze": {
					"on_entry": [
						"/execute @s ~ ~ ~ fill ~2 ~1 ~2 ~-2 ~-1 ~-2 ice 0 replace water",
						"/execute @s ~ ~ ~ fill ~2 ~1 ~2 ~-2 ~-1 ~-2 ice 0 replace snow",
						"/execute @e[r=6,family=!golem] ~ ~ ~ effect @s slowness 2 3 true"
					],
          "transitions": [
						{
							"start": "1"
						}
          ]
        }
			}
		}
	}
}